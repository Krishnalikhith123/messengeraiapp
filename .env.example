# ⚙️ Environment Configuration File
# Copy this to .env in the project root and fill in your API keys

# ==========================================
# 🤖 AI & LLM Configuration
# ==========================================
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Separate key used only by Advanced AI Lab. Kane AI can keep using GEMINI_API_KEY.
AI_LAB_GEMINI_API_KEY=your_ai_lab_gemini_api_key_here
AI_LAB_GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# 📰 News & Weather Configuration
# ==========================================
# Get from: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ==========================================
# 🔐 GitHub Integration
# ==========================================
# Setup: https://github.com/settings/developers → Create OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/integrations/github/callback

# ==========================================
# 🔗 JIRA Integration
# ==========================================
# Setup: https://developer.atlassian.com/cloud/jira/
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_CALLBACK_URL=http://localhost:5000/api/integrations/jira/callback

# ==========================================
# 🏥 Health Integration (Optional)
# ==========================================
# Apple Health OAuth - Requires special registration
APPLE_HEALTH_CLIENT_ID=your_apple_health_client_id
APPLE_HEALTH_CLIENT_SECRET=your_apple_health_client_secret

# Google Fit OAuth - Get from: https://console.cloud.google.com/
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret

# Fitbit API - Get from: https://dev.fitbit.com/
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# ==========================================
# 📱 Database Configuration
# ==========================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/mern-messenger

# Or MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mern-messenger

# ==========================================
# 🔑 Authentication & Security
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ==========================================
# 🖥️ Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# ==========================================
# 📧 Email Configuration (Optional)
# ==========================================
# SMTP settings for sending emails/notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@chatflow.app

# ==========================================
# ☁️ Cloud Storage (Optional)
# ==========================================
# AWS S3 for file uploads
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# ==========================================
# 📊 Analytics & Monitoring (Optional)
# ==========================================
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn

# Google Analytics
GOOGLE_ANALYTICS_ID=your_ga_id

# ==========================================
# 🔔 Push Notifications (Optional)
# ==========================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# ==========================================
# 🎨 Feature Flags
# ==========================================
ENABLE_AI_FEATURES=true
ENABLE_HEALTH_TRACKING=true
ENABLE_EXPENSE_TRACKING=true
ENABLE_PROJECT_INTEGRATION=true
ENABLE_AR_FILTERS=true
ENABLE_CODE_ANALYSIS=true

# ==========================================
# 🧹 Development Settings
# ==========================================
# Set to true to enable detailed logging
DEBUG=false
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API call rate limiting per user
API_RATE_LIMIT_CALLS_PER_MINUTE=60
